# Lecture des cartes par Claude (vision). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé pour la lecture, modifiable sans toucher au code.
ANTHROPIC_MODEL=claude-opus-5-5
# Effort de raisonnement : low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# API publique PSA (vérification de certificat). Compte psacard.com > Public API.
PSA_API_TOKEN=
# Pause entre deux appels à l'API PSA, en ms (l'offre gratuite est limitée à ~100 appels/jour).
PSA_API_DELAY_MS=1500

# Délai de stabilité avant capture automatique, en ms.
CAPTURE_STABLE_MS=600

# Lecture des pages publiques de population PSA : laisser à false tant que les CGU ne l'autorisent pas.
PSA_PAGES_FETCH_ENABLED=false

# Dossier des données locales (base SQLite, images, caches).
DATA_DIR=./data
